                <mxCell id="145" value="&lt;div&gt;handles the state machine of ext_btns &amp;amp;&amp;amp; the state machine of btns :&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;light_ctx = pvParameters&lt;div&gt;btns[2] = btn_1, btn_2 : from light_ctx&lt;/div&gt;&lt;div&gt;exts[2] = ext_1, ext_2 : from light_ctx&lt;/div&gt;&lt;div style=&quot;&quot;&gt;create fctry_reset_timer, assign &lt;b&gt;cb &lt;/b&gt;from the same file&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;startup : for 2 exts =&amp;gt; set state to ARMED , idle_lvl to pin_lvl&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;while(1) :&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;if queue receives an elt = event :&lt;/div&gt;&lt;div style=&quot;&quot;&gt;ext_btn or btn ? (if exts[i]==event.pin =&amp;gt; ext_btn event, else : btn)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- if ext_btn :&lt;/div&gt;&lt;div style=&quot;&quot;&gt;get the pin corresponding to the event (ext_btn_1_pin or ext_btn_2_pin),&lt;/div&gt;&lt;div style=&quot;&quot;&gt;update the state machine&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- if btn :&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;btn_1_pin or btn_2_pin ? , debounce filter&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;if not debounce :&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;handle btns state machine :&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;-- if&amp;nbsp; btn pressed (negedge) : update btn-&amp;gt;pressed,last_edge,press_time&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;, if both pressed : timer start&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;-- if btn released (posedge) : if both pressed : stop timer,&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;if not in combo : duration = event.timestamp - btn-&amp;gt;press_time,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;if duration &amp;lt;&amp;nbsp;LONG_PRESS_INF_MS : short press : light_toggle_onoff(btn-&amp;gt;light)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;else : long press : do nothing&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
